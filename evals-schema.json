{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "inputs": {
            "type": "string"
          },
          "expected_output": {
            "type": "string"
          },
          "metadata": {
            "type": "object",
            "additionalProperties": true
          },
          "evaluators": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "EqualsExpected",
                "Contains",
                "IsInstance",
                "LLMJudge"
              ]
            }
          }
        },
        "required": [
          "name",
          "inputs"
        ],
        "additionalProperties": false
      }
    },
    "evaluators": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "EqualsExpected",
          "Contains",
          "IsInstance",
          "LLMJudge"
        ]
      },
      "default": []
    }
  },
  "required": [
    "cases"
  ],
  "additionalProperties": false
}
